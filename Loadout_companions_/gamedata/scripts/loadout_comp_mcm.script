local debugx = true
local DEFAULT_COMPANION_BASE_NAME = "Companion"

function pr(...)
	if not debugx then return end
	printf(...)
end

function actor_on_first_update()
	db.actor:iterate_inventory( function(temp, item)
		local squad_sec
		local item_sec = item:section()
		if item_sec and string.find(item_sec, "_comp_item") then
			pr("item_sec: [ %s ]", item_sec)
			squad_sec = item_sec:gsub("_comp_item", "")
			pr("squad_sec_after_sub: [ %s ]", squad_sec)
			alife_release(item)
			if squad_sec then
				create_companion_squad(squad_sec)
			end
		end
	end)

end

-- Генерирует уникальное имя на основе базового и id объекта
local function generate_unique_name(base, id)
	if id then
		return base .. "_" .. tostring(id)
	else
		return base .. "_" .. tostring(math.random(1000, 9999))
	end
end

-- Безопасный сеттер имени (пыт��емся разные методы, и записываем fallback-поле)
local function set_companion_name(obj, name)
	if not obj or not name then return end
	local ok = false
	if obj.set_name then
		pcall(function() obj:set_name(name) end)
		ok = true
	end
	if obj.SetName and not ok then
		pcall(function() obj:SetName(name) end)
		ok = true
	end
	if obj.set_npc_name and not ok then
		pcall(function() obj:set_npc_name(name) end)
		ok = true
	end
	if obj.set_nickname and not ok then
		pcall(function() obj:set_nickname(name) end)
		ok = true
	end
	-- попытка записать в поле, если методы не сработали
	if not ok then
		pcall(function() obj.name = name end)
	end
	-- попытка записать в поле npc_name если оно существует
	pcall(function() if obj.npc_name ~= nil then obj.npc_name = name end end)
end

function create_companion_squad(sec)
	local pos
	local gvid = db.actor:game_vertex_id()
	local lvid = 4294967295
	repeat
		local dir = vector_rotate_y(db.actor:direction(), math.random(1, 359))
		pos = db.actor:position():add(dir:mul(math.random(1, 5)))
		lvid = level.vertex_id(pos)
	until (pos ~= nil and lvid ~= 4294967295)

	local comp_squad_x = alife_create(tostring(sec), pos, lvid, gvid)
	if not comp_squad_x then return end

	pr("# adding npc to squad_id: [ %s ], at pos: [ %s ] || lvid: [ %s ] || gvid: [ %s ]", comp_squad_x.id, pos, lvid, gvid)
	comp_squad_x:create_npc(nil, pos, lvid, gvid)

	if comp_squad_x.squad_members then
		for k in comp_squad_x:squad_members() do
			local se_npc = k.object or k.id and alife_object(k.id)
			if se_npc then
				pr("#setting some server shit")
				SIMBOARD:setup_squad_and_group(se_npc)
			end
			local function delay(id)
				if id then
					pr("#game obj id found")
					local companion = level.object_by_id(id)
					if companion then
						pr("#game obj found || setting game object relation and squad")
						companion:set_relation(game_object.friend, db.actor)
						-- Генерируем уникальное имя и пытаемся его установить
						local unique_name = generate_unique_name(DEFAULT_COMPANION_BASE_NAME, id)
						set_companion_name(companion, unique_name)
						-- Если модуль диалогов предоставляет метод установки имени — используем его
						if dialogs_axr_companion and dialogs_axr_companion.set_companion_name then
							pcall(function() dialogs_axr_companion.set_companion_name(companion, unique_name) end)
						elseif dialogs_axr_companion and dialogs_axr_companion.SetCompanionName then
							pcall(function() dialogs_axr_companion.SetCompanionName(companion, unique_name) end)
						end
						-- Также пробуем пометить компаньона как актёрского компаньона
						dialogs_axr_companion.become_actor_companion(db.actor, companion)
					end
				end
				return true
			end
			CreateTimeEvent("delay_companion_squad_ev", "delay_companion_squad_ac_" .. k.id, 1, delay, k.id)
		end
		end
	
end

LoadoutCompX = ui_mm_faction_select.UINewGame.LoadLoadout
function ui_mm_faction_select.UINewGame.LoadLoadout(self, rand)
	LoadoutCompX(self, rand)

	-- Copy existing loadout
	local t_loadout, p_loadout = {}, {}
	local size_loadout = 0
	for idx, ci in pairs(self.CC["loadout"].cell) do
		size_loadout = size_loadout + 1
		t_loadout[size_loadout] = ci.section
		p_loadout[size_loadout] = ci.flags.info or 0
	end

	-- add companions
	local amount_for_each = 3	-- amount of each companion tier
	local points_per_tier = 200	-- points cost per tier

	local eco_idxs = self.selected_economy:gsub("st_econ_","") or "1"
	local reverse_eco_num = clamp(4 - tonumber(eco_idxs), 1, 3)

	for i = 1, reverse_eco_num do
		for j = 1, amount_for_each do
			size_loadout = size_loadout + 1
			t_loadout[size_loadout] = self.selected_faction .. "_sim_squad_comp_" .. tostring(i) .. "_comp_item"
			p_loadout[size_loadout] = i * points_per_tier
		end
	end

	-- reinit loadout
	self.CC["loadout"]:Reinit(t_loadout, p_loadout)
	for idx,ci in pairs(self.CC["loadout"].cell) do
		if ci:IsShown() then
			local val = ci.flags.info or 0
			ci.flags.value = val
			ci.flags.value_str = game.translate_string("st_mm_new_game_points") .. ": " .. val
		end
	end

end

function on_game_start()
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
end
