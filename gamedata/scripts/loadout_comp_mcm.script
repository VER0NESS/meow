local debugx = true
function pr(...)
	if not debugx then return end
	printf(...)
end

-- Spawn one deterministic companion from the fixed squad definition.
-- The old implementation added several tiered sim squads; those NPCs use the
-- game's random simulator supplies.  Keeping the item as a token also means
-- old saves cannot accidentally create a second companion.
function actor_on_first_update()
	db.actor:iterate_inventory(function(temp, item)
		local item_sec = item:section()
		if item_sec == "companion_fixed_item" then
			alife_release(item)
			create_companion_squad("companion_fixed")
		end
	end)
end

function create_companion_squad(sec)
	local pos
	local gvid = db.actor:game_vertex_id()
	local lvid = 4294967295
	repeat
		local dir = vector_rotate_y(db.actor:direction(), math.random(1, 359))
		pos = db.actor:position():add(dir:mul(math.random(1, 5)))
		lvid = level.vertex_id(pos)
	until (pos ~= nil and lvid ~= 4294967295)

	local comp_squad_x = alife_create(sec, pos, lvid, gvid)
	if not comp_squad_x then return end

	pr("# adding fixed companion squad_id: [ %s ]", comp_squad_x.id)
	comp_squad_x:create_npc(nil, pos, lvid, gvid)

	if comp_squad_x.squad_members then
		for k in comp_squad_x:squad_members() do
			local se_npc = k.object or k.id and alife_object(k.id)
			if se_npc then
				SIMBOARD:setup_squad_and_group(se_npc)
			end
			local function delay(id)
				if id then
					local companion = level.object_by_id(id)
					if companion then
						companion:set_relation(game_object.friend, db.actor)
						dialogs_axr_companion.become_actor_companion(db.actor, companion)
					end
				end
				return true
			end
			CreateTimeEvent("fixed_companion_squad_ev", "fixed_companion_" .. k.id, 1, delay, k.id)
		end
	end
end

LoadoutCompX = ui_mm_faction_select.UINewGame.LoadLoadout
function ui_mm_faction_select.UINewGame.LoadLoadout(self, rand)
	LoadoutCompX(self, rand)

	-- One purchasable token.  The NPC and all of its supplies are fixed in the
	-- companion profile; no faction/economy-dependent randomized tiers remain.
	local t_loadout, p_loadout = {}, {}
	for _, ci in pairs(self.CC["loadout"].cell) do
		t_loadout[#t_loadout + 1] = ci.section
		p_loadout[#p_loadout + 1] = ci.flags.info or 0
	end
	t_loadout[#t_loadout + 1] = "companion_fixed_item"
	p_loadout[#p_loadout + 1] = 200

	self.CC["loadout"]:Reinit(t_loadout, p_loadout)
	for _, ci in pairs(self.CC["loadout"].cell) do
		if ci:IsShown() then
			local val = ci.flags.info or 0
			ci.flags.value = val
			ci.flags.value_str = game.translate_string("st_mm_new_game_points") .. ": " .. val
		end
	end
end

function on_game_start()
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
end
